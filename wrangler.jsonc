{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-boiler",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-boiler-develop",
      "database_id": "b4ca3b08-637e-4e53-879a-9f31c08f9a1a",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // D1 bindings are intentionally not inherited by Wrangler environments.
    // Add a separate database binding to each environment after local validation.
    "preview": {
      "name": "astro-boiler-preview",
      "keep_vars": true,
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
      },
    },
    "staging": {
      "name": "astro-boiler-staging",
      "keep_vars": true,
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
      },
    },
    "production": {
      "name": "astro-boiler",
      "keep_vars": true,
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
      },
    },
  },
}
