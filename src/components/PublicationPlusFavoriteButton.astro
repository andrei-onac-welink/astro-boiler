---
type Props = {
  publicationPlusId: string;
};

const { publicationPlusId } = Astro.props;
---

<button
  aria-busy="true"
  aria-label="Loading favorite status"
  class="inline-flex h-10 w-48 animate-pulse items-center justify-center rounded-full border border-slate-300 bg-slate-100 px-4 text-sm font-semibold disabled:cursor-wait disabled:opacity-60 dark:border-slate-600 dark:bg-slate-800"
  data-publication-plus-favorite-button
  data-publication-plus-id={publicationPlusId}
  disabled
  type="button"
>
  <span aria-hidden="true" class="block h-4 w-32 rounded-full bg-slate-300 dark:bg-slate-600"></span>
</button>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-publication-plus-favorite-button]:not([data-ready])",
  );

  for (const button of buttons) {
    button.dataset.ready = "true";
    const publicationPlusId = button.dataset.publicationPlusId;
    if (!publicationPlusId) continue;

    const endpoint = `/api/publication-plus-favorites/${encodeURIComponent(publicationPlusId)}/`;

    const finishLoading = () => {
      button.classList.remove(
        "animate-pulse",
        "border-slate-300",
        "bg-slate-100",
        "dark:border-slate-600",
        "dark:bg-slate-800",
      );
      button.classList.add("border-blue-700", "text-blue-700", "dark:border-blue-400", "dark:text-blue-300");
      button.removeAttribute("aria-busy");
      button.removeAttribute("aria-label");
      button.disabled = false;
    };

    const render = (favorite: boolean) => {
      button.dataset.favorite = String(favorite);
      button.textContent = favorite ? "Remove from favorites" : "Add to favorites";
      finishLoading();
    };

    let response: Response;
    try {
      response = await fetch(endpoint, { credentials: "same-origin" });
    } catch {
      button.textContent = "Favorites unavailable";
      finishLoading();
      button.disabled = true;
      continue;
    }
    if (response.ok) {
      const data = (await response.json()) as { favorite: boolean };
      render(data.favorite);
    } else if (response.status === 401) {
      button.textContent = "Log in to add favorites";
      finishLoading();
      button.addEventListener("click", () => {
        window.location.href = `/login/?returnTo=${encodeURIComponent(window.location.pathname)}`;
      });
      continue;
    } else {
      button.textContent = "Favorites unavailable";
      finishLoading();
      button.disabled = true;
      continue;
    }

    button.addEventListener("click", async () => {
      button.disabled = true;
      const favorite = button.dataset.favorite === "true";
      const update = await fetch(endpoint, {
        method: favorite ? "DELETE" : "POST",
        credentials: "same-origin",
      });

      if (update.ok) {
        const data = (await update.json()) as { favorite: boolean };
        render(data.favorite);
      }
      button.disabled = false;
    });
  }
</script>
