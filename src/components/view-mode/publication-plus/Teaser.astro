---
import type { CollectionEntry } from "astro:content";
import PublicationPlusFavoriteButton from "@components/PublicationPlusFavoriteButton.astro";

type Props = {
  entry: CollectionEntry<"publication-plus">;
};

const { entry } = Astro.props;
---

<article class="h-full rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">Publication Plus</p>
  <h2 class="mt-2 text-xl font-semibold">
    <a href={`/publication-plus/${entry.data.slug}/`}>{entry.data.title}</a>
  </h2>
  {entry.data.abstract && <p class="mt-3 line-clamp-3 text-slate-600">{entry.data.abstract}</p>}
  <div class="mt-5">
    <PublicationPlusFavoriteButton publicationPlusId={entry.id} />
  </div>
</article>
