---
import type { CollectionEntry } from "astro:content";
import PublicationFavoriteButton from "@components/PublicationFavoriteButton.astro";

type Props = {
  entry: CollectionEntry<"publication">;
};

const { entry } = Astro.props;
---

<article class="h-full rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">Publication</p>
  <h2 class="mt-2 text-xl font-semibold">
    <a href={`/publication/${entry.data.slug}/`}>{entry.data.title}</a>
  </h2>
  <div class="mt-5">
    <PublicationFavoriteButton publicationId={entry.id} />
  </div>
</article>
