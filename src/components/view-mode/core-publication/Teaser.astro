---
import type { CorePublicationFeedEntry } from "@schemas/core-publication-feed.ts";

type Props = {
  publication: CorePublicationFeedEntry;
};

const { publication } = Astro.props;
---

<article class="h-full rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">LT Core publication</p>
  <h3 class="mt-2 text-xl font-semibold">
    <a href={`/publication/${publication.uuid}/`}>{publication.title}</a>
  </h3>
  <p class="mt-3 text-slate-600">{publication.author}</p>
</article>
