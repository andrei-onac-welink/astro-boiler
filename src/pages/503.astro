---
import Base from "@layouts/Base.astro";

export const prerender = false;
Astro.response.status = 503;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Retry-After", "60");
---

<Base robots="noindex, nofollow" title="Temporarily unavailable">
  <h1 class="text-4xl font-semibold">Publication temporarily unavailable</h1>
  <p class="mt-4">The publication service could not be reached. Please try again shortly.</p>
</Base>
