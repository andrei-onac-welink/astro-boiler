---
import { getCollection } from "astro:content";
import ViewMode from "@components/view-mode/ViewMode.astro";
import { config } from "@config/index.ts";
import Base from "@layouts/Base.astro";

export const prerender = true;

const publicationPlusEntries = (await getCollection("publication-plus")).filter(
  (entry) => entry.data.strapiStatus === "published" || config.includeDrafts,
);
---

<Base title="Publication Plus">
  <h1 class="text-4xl font-semibold">Publication Plus</h1>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {publicationPlusEntries.map((entry) => (
      <ViewMode entry={entry} mode="teaser" />
    ))}
  </div>
</Base>
