---
import Base from "@layouts/Base.astro";
import { getAuthSession } from "@lib/auth.ts";

const session = await getAuthSession(Astro.request);
if (session) return Astro.redirect("/account/");
---

<Base title="Log in">
  <div class="mx-auto max-w-lg rounded-2xl bg-white p-8 shadow-sm">
    <h1 class="text-3xl font-semibold">Log in</h1>
    <form class="mt-6 grid gap-4" data-login-form>
      <label class="grid gap-1 font-medium">
        Email
        <input class="rounded-lg border border-slate-300 px-3 py-2" name="email" required type="email" />
      </label>
      <label class="grid gap-1 font-medium">
        Password
        <input
          class="rounded-lg border border-slate-300 px-3 py-2"
          minlength="8"
          name="password"
          required
          type="password"
        />
      </label>
      <p class="text-sm text-red-700" data-auth-error role="alert"></p>
      <button class="rounded-lg bg-blue-700 px-4 py-3 font-semibold text-white disabled:opacity-60" type="submit">
        Log in
      </button>
    </form>
    <p class="mt-5 text-sm text-slate-600">
      Local development only:{" "}
      <a class="font-medium text-blue-700" href="/register/">
        create a test account
      </a>
      .
    </p>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-login-form]");
  const errorElement = document.querySelector<HTMLElement>("[data-auth-error]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const data = new FormData(form);
    if (submit) submit.disabled = true;
    if (errorElement) errorElement.textContent = "";

    const response = await fetch("/api/auth/sign-in/email/", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: String(data.get("email")),
        password: String(data.get("password")),
        rememberMe: true,
      }),
    });

    if (!response.ok) {
      const result = (await response.json().catch(() => null)) as { message?: string } | null;
      if (errorElement) errorElement.textContent = result?.message || "Login failed";
      if (submit) submit.disabled = false;
      return;
    }

    const requestedPath = new URLSearchParams(window.location.search).get("returnTo");
    const returnTo = requestedPath?.startsWith("/") && !requestedPath.startsWith("//") ? requestedPath : "/account/";
    window.location.href = returnTo;
  });
</script>
